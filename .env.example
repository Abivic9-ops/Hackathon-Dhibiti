# ═══════════════════════════════════════════════════════════════════════════
# Dhibiti — Environment variables
# ═══════════════════════════════════════════════════════════════════════════
#
# HOW TO USE THIS FILE
#   1. Copy this file to  .env.local  (git-ignored — see .gitignore) and
#      paste your real values in. There is no plain `.env` anymore.
#   2. `npx convex dev` will also write/refresh the three Convex keys at the
#      top of .env.local for you — leave those alone.
#
# RULE THAT KEEPS SECRETS OUT OF THE APP STORE
#   Anything prefixed  EXPO_PUBLIC_  IS embedded into the shipped JS bundle
#   (you may only put keys the app may legally display there). Every other key
#   is a SERVER-side secret. Server secrets are set with `npx convex env set
#   KEY value` and read ONLY inside Convex functions (convex/lib/serverEnv.ts)
#   via process.env — they never reach the bundle.
#   ⚠️  Never put a server API key under EXPO_PUBLIC_.

# ── Convex backend (REQUIRED) ═════════════════════════════════════════════
# Written by `npx convex dev` into .env.local. Do not edit by hand.
#   CONVEX_DEPLOYMENT           e.g. dev:rare-ostrich-803   (no https://)
#   EXPO_PUBLIC_CONVEX_URL      e.g. https://rare-ostrich-803.convex.cloud
#   EXPO_PUBLIC_CONVEX_SITE_URL e.g. https://rare-ostrich-803.convex.site
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# ── Optional custom data backend (EXPO_PUBLIC_ = client-safe) ─────────────
# Leave empty to run on the Convex backend alone.
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_BACKEND_ANON_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# SERVER-SIDE secrets — set with  npx convex env set KEY value
# All of these are read ONLY inside convex/ server functions. Copy the block
# below into a terminal or a Convex config; the app bundle never sees them.
# ═══════════════════════════════════════════════════════════════════════════

# URL safety & reputation
SAFE_BROWSING_API_KEY=          # Google Safe Browsing → malware/pishing URLs
VIRUSTOTAL_API_KEY=             # VirusTotal → URL & file reputation
IPQUALITYSCORE_API_KEY=         # IPQualityScore → fraud score / proxy / VPN
URLSCAN_IO_API_KEY=             # urlscan.io → URL scan & screenshot

# Phone number intelligence
NUMVERIFY_API_KEY=              # Numverify → validate + geolocate phone numbers
TRUE_CALLER_CLIENT_ID=          # Truecaller client ID → caller-name lookup
AFRICAS_TALKING_SMS_API_KEY=    # Africa's Talking → SMS delivery (OTP, alerts)

# SMS OTP delivery
SMS_OTP_API_KEY=                # OTP gateway key (Africa's Talking / AT sandbox)

# AI explanation — GROQ (llama-3.x free tier) ═══════════════════════════════
# GROQ is the AI provider for plain-language scam explanations and the
# "what is phishing?" glossary lookups. Uses a free-tier OpenAI-compatible
# model (e.g. llama-3.1-8b-instant). Get a key at console.groq.com.
GROQ_API_KEY=

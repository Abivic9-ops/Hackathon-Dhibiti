# ──────────────────────────────────────────────────────────────
# Dhibiti — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# ── Backend (optional) ────────────────────────────────────────
# Endpoint + anonymous key for the app's data backend.
# EXPO_PUBLIC_ prefix makes these available in client-side code.
# EXPO_PUBLIC_BACKEND_URL=
# EXPO_PUBLIC_BACKEND_ANON_KEY=

# ── Expo Build Config ─────────────────────────────────────────
# Set to "native" to conditionally load native-only plugins
# (e.g. expo-dev-client) during local dev or EAS builds.
# EXPO_PLATFORM=native

# ── App Identity & Versioning ─────────────────────────────────
# Used in app.config.ts for iOS bundle ID, Android package,
# App Store ID, and runtime version.
# DHIBITI_APP_VERSION=1.0.0
# DHIBITI_IOS_BUNDLE_ID=com.dhibiti.app
# DHIBITI_ANDROID_PACKAGE=com.dhibiti.app
# DHIBITI_APP_STORE_APP_ID=
